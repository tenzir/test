---
fixtures: [node]
timeout: 60
---

pipeline_detach {
  every 10ms {
    from {id: 1}, {id: 2}
  }
  publish "foo"
}

pipeline_detach {
  subscribe "foo"
  where id == 1
  publish "bar"
}

pipeline_detach {
  subscribe "foo"
  where id == 2
  publish "bar"
}

subscribe "bar"
deduplicate
head 2
sort
